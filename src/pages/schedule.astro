---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
---

<PageLayout
  title="Get In Touch | Better Lives Building Tribes"
  description="Reach out to Better Lives Building Tribes to start your therapy journey. Call or email us today."
>
  <Section padding="lg">
    <div class="schedule-header">
      <h1>Let's Connect</h1>
      <p>
        Ready to take the next step? Reach out and we'll help you find the right
        therapist and get started on your journey.
      </p>
    </div>

    <div class="contact-options">
      <a href="mailto:BetterLives.BuildingTribes@gmail.com" class="option-card">
        <Icon name="email" size={28} />
        <h2>Email Us</h2>
        <p>BetterLives.BuildingTribes@gmail.com</p>
      </a>

      <a href="tel:7202951508" class="option-card">
        <Icon name="phone" size={28} />
        <h2>Call Us</h2>
        <p>(720) 295-1508</p>
      </a>
    </div>
  </Section>

  <Section background="cream" padding="md">
    <div class="contact-cta">
      <p>You can also reach us through our contact form.</p>
      <Button href="/contact" variant="primary">Go to Contact Form</Button>
    </div>
  </Section>
</PageLayout>

<style>
  .schedule-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }

  .schedule-header h1 {
    color: var(--color-teal);
    margin-bottom: var(--space-xs);
  }

  .schedule-header p {
    line-height: 1.7;
  }

  .contact-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    max-width: 700px;
    margin: 0 auto;
  }

  .option-card {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
    background: var(--color-cream);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text-dark);
    transition: box-shadow var(--transition-fast);
  }

  .option-card:hover {
    box-shadow: var(--shadow-md);
  }

  .option-card h2 {
    color: var(--color-teal);
    font-size: var(--font-size-md);
    margin: var(--space-sm) 0 var(--space-xs);
  }

  .option-card p {
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .contact-cta {
    text-align: center;
  }

  .contact-cta p {
    margin-bottom: var(--space-md);
  }

  @media (max-width: 640px) {
    .contact-options {
      grid-template-columns: 1fr;
    }
  }
</style>
